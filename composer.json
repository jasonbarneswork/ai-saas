{
    "name": "jasonbarnes/ai-saas-platform",
    "description": "AI SaaS Platform",
    "type": "project",
    "require": {
        "php": "^8.4",
        "slim/slim": "4.*",
        "slim/psr7": "^1.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
